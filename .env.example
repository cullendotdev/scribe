# -----------------------------------------------------------------------------
# Core Configuration (Required)
# -----------------------------------------------------------------------------
# The URL for the PostgreSQL database
DATABASE_URL=ecto://postgres:postgres@localhost/social_scribe_dev

# General Config - Used for oauth callback url's
PHX_HOST="localhost:4000"

# A secret key used for signing and encrypting cookies.
# Generate one with: mix phx.gen.secret
SECRET_KEY_BASE=

# -----------------------------------------------------------------------------
# AI and Meeting Transcription (Required)
# -----------------------------------------------------------------------------
# Your Google Gemini API Key for content generation
GEMINI_API_KEY=

# Your Recall.ai API Key for meeting transcription
RECALL_API_KEY=
RECALL_REGION=us-west-2

# -----------------------------------------------------------------------------
# Google Integration (Required for Login & Calendar)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# CRM Integrations (Optional)
# -----------------------------------------------------------------------------

# Salesforce
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# HubSpot
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Social Media Integrations (Optional)
# -----------------------------------------------------------------------------

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
